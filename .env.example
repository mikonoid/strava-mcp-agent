# Everything here can also be filled in from the web dashboard (Settings page).

# Get these from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Filled automatically after "Connect with Strava" (web) or auth_setup.py (CLI)
STRAVA_REFRESH_TOKEN=

# Optional: Garmin Connect credentials
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Optional: AI coach in the web dashboard
# LLM_PROVIDER=anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For Ollama / other OpenAI-compatible servers, e.g. http://localhost:11434/v1
OPENAI_BASE_URL=
